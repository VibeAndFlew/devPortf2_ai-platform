{
  "name": "nova-ai-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native workflow operating system — intelligent agent orchestration, knowledge base management, prompt engineering studio, vector search, and multi-model playground.",
  "license": "MIT",
  "author": "NOVA AI Team",
  "homepage": "https://nova-ai.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/novalabs/nova-ai-workflow"
  },
  "bugs": {
    "url": "https://github.com/novalabs/nova-ai-workflow/issues"
  },
  "keywords": [
    "ai",
    "workflow",
    "agent-orchestration",
    "llm",
    "nextjs",
    "react",
    "prompt-engineering",
    "rag",
    "vector-search",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev -p 4003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "clean": "del /f /s /q .next 2>nul & del /f /s /q node_modules/.cache 2>nul & echo Cleaned",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1",
    "@radix-ui/react-avatar": "^1",
    "@radix-ui/react-checkbox": "^1",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^1",
    "@radix-ui/react-label": "^1",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-progress": "^1",
    "@radix-ui/react-scroll-area": "^1",
    "@radix-ui/react-select": "^1",
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-switch": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-toast": "^1",
    "@radix-ui/react-tooltip": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "framer-motion": "^12",
    "lucide-react": "^0.400",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3",
    "tailwindcss-animate": "^1",
    "zod": "^3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
